# Docker Compose reads this file after you copy it to .env.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
SESSION_SECRET=replace-with-a-long-random-session-secret
FACE_AI_TOKEN=replace-with-the-cloud-ai-token
# Local mode: http://face-ai:8000. Cloud mode: https://<your-space>.hf.space
FACE_AI_URL=http://face-ai:8000
SESSION_COOKIE_SECURE=false
